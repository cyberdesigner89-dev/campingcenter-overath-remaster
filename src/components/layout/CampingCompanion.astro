---
import Icon from '@/components/ui/Icon.astro';
import UniversalAccessIcon from '@/components/ui/UniversalAccessIcon.astro';
import AccessibilityPrefs from '@/components/layout/AccessibilityPrefs.astro';
import { company } from '@/data/company';
import { CAMPING_QUICK_PROMPTS } from '@/lib/camping-assist';
import { url } from '@/lib/url';

---

<div
  class="companion"
  data-companion
  data-size="md"
  data-i18n-title={'Hilfe & Barrierefreiheit'}
  data-i18n-sub={'Wir helfen dir gerne weiter.'}
>
  <button
    type="button"
    class="companion-fab"
    data-companion-open
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="companion-panel"
    aria-label={'Hilfe, Camping-KI und Barrierefreiheit öffnen'}
  >
    <span class="companion-fab-tip" aria-hidden="true">{'Hilfe & Barrierefreiheit'}</span>
    <span class="companion-fab-mark" aria-hidden="true">
      <UniversalAccessIcon />
    </span>
  </button>

  <dialog
    class="companion-panel"
    id="companion-panel"
    data-companion-panel
    aria-labelledby="companion-title"
    aria-describedby="companion-sub"
  >
    <div class="companion-sheet">
      <header class="companion-head">
        <div class="companion-head-copy">
          <h2 id="companion-title">{'Hilfe & Barrierefreiheit'}</h2>
          <p class="companion-sub" id="companion-sub">{'Wir helfen dir gerne weiter.'}</p>
        </div>
        <div class="companion-head-tools">
          <div class="companion-sizes" role="group" aria-label={'Fenstergröße'}>
            <button type="button" class="companion-size-btn" data-companion-size="sm" aria-pressed="false">
              {'KLEIN'}
            </button>
            <button type="button" class="companion-size-btn is-active" data-companion-size="md" aria-pressed="true">
              {'MITTEL'}
            </button>
            <button type="button" class="companion-size-btn" data-companion-size="lg" aria-pressed="false">
              {'GROSS'}
            </button>
          </div>
          <button type="button" class="companion-icon-btn" data-companion-minimize aria-label={'Minimieren'}>
            <span aria-hidden="true">–</span>
          </button>
          <button type="button" class="companion-icon-btn" data-companion-close aria-label={'Schließen'}>
            <Icon name="close" />
          </button>
        </div>
      </header>

      <div class="companion-tabs" role="tablist" aria-label={'Hilfe & Barrierefreiheit'}>
        <button
          type="button"
          class="companion-tab companion-tab--a11y is-active"
          role="tab"
          id="companion-tab-a11y"
          aria-selected="true"
          aria-controls="companion-panel-a11y"
          data-companion-tab="a11y"
        >
          <span class="companion-tab-a11y-mark" aria-hidden="true">
            <UniversalAccessIcon class="companion-tab-a11y-svg" />
          </span>
          <span>{'Barrierefreiheit'}</span>
        </button>
        <button
          type="button"
          class="companion-tab"
          role="tab"
          id="companion-tab-chat"
          aria-selected="false"
          aria-controls="companion-panel-chat"
          data-companion-tab="chat"
          tabindex="-1"
        >
          {'Camping-KI'}
        </button>
        <button
          type="button"
          class="companion-tab"
          role="tab"
          id="companion-tab-contact"
          aria-selected="false"
          aria-controls="companion-panel-contact"
          data-companion-tab="contact"
          tabindex="-1"
        >
          {'Kontakt'}
        </button>
      </div>

      <div class="companion-body">
        <div
          class="companion-view is-active"
          role="tabpanel"
          id="companion-panel-a11y"
          aria-labelledby="companion-tab-a11y"
          data-companion-view="a11y"
        >
          <AccessibilityPrefs embedded />
          <p class="companion-a11y-note">
            Diese Einstellungen erleichtern die Nutzung dieser Website. Sie ersetzen keine vollständige
            Barrierefreiheitsprüfung.
            <a href={url('/barrierefreiheit/')}>{'Erklärung zur Barrierefreiheit'}</a>
          </p>
        </div>

        <div
          class="companion-view"
          role="tabpanel"
          id="companion-panel-chat"
          aria-labelledby="companion-tab-chat"
          data-companion-view="chat"
          hidden
        >
          <div class="companion-chat" data-companion-chat>
            <div class="companion-chat-body" data-companion-chat-body>
              <div class="companion-chat-msg companion-chat-msg-bot is-latest" data-companion-chat-msg>
                <p class="companion-chat-lead">{'Hallo – wie kann ich helfen?'}</p>
                <p>
                  {
                    'Fragen zu Challenger, Kauf, Miete, Ankauf, Öffnungszeiten oder Service. Kurze Stichworte reichen.'
                  }
                </p>
              </div>
              <div class="companion-chat-chips" data-companion-chat-chips>
                {
                  CAMPING_QUICK_PROMPTS.map((q) => (
                    <button type="button" class="companion-chat-chip" data-companion-chat-chip data-text={q.text}>
                      {q.label}
                    </button>
                  ))
                }
              </div>
              <div class="companion-chat-anchor" data-companion-chat-anchor aria-hidden="true"></div>
            </div>
            <form class="companion-chat-composer" data-companion-chat-form>
              <label class="sr-only" for="companion-chat-input">{'Nachricht an Camping-KI'}</label>
              <div class="companion-chat-input-wrap">
                <textarea
                  id="companion-chat-input"
                  name="message"
                  rows="1"
                  placeholder={'Nachricht an Camping-KI …'}
                  data-companion-chat-input
                  maxlength="800"
                ></textarea>
                <button type="submit" class="companion-chat-send" data-companion-chat-send aria-label={'Senden'}>
                  <Icon name="arrow-right" />
                </button>
              </div>
              <p class="companion-chat-hint">{'Enter senden · Shift+Enter neue Zeile'}</p>
            </form>
          </div>
        </div>

        <div
          class="companion-view"
          role="tabpanel"
          id="companion-panel-contact"
          aria-labelledby="companion-tab-contact"
          data-companion-view="contact"
          hidden
        >
          <section class="companion-contact" aria-label={'Kontakt'}>
            <p class="companion-contact-lead">
              Persönliche Beratung in Overath – Anruf, Nachricht oder Anfahrt.
            </p>
            <div class="companion-contact-actions">
              <a
                class="btn btn-accent companion-contact-btn"
                href={company.phone.href}
                data-track="call_click"
                data-track-location="companion"
              >
                <Icon name="phone" />
                {'Jetzt anrufen'}
              </a>
              <a
                class="btn companion-contact-btn"
                href={url('/kontakt/')}
                data-track="cta_click"
                data-track-location="companion"
              >
                <Icon name="mail" />
                {'Nachricht schreiben'}
              </a>
              <a
                class="btn companion-contact-btn"
                href={company.directions}
                target="_blank"
                rel="noopener noreferrer"
                data-track="cta_click"
                data-track-location="companion-route"
              >
                <Icon name="route" />
                {'Route planen'}
              </a>
            </div>
            <p class="companion-contact-meta">
              <a href={company.phone.href}>{company.phone.display}</a>
              ·
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </p>
            <p class="companion-contact-meta">
              {company.address.street}, {company.address.postalCode} {company.address.city}
            </p>
          </section>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { initCompanion } from '@/scripts/companion';
  initCompanion();
  document.addEventListener('astro:page-load', () => initCompanion());
  document.addEventListener('astro:after-swap', () => initCompanion());
</script>

<style>
  .companion {
    --companion-bottom: calc(var(--actionbar-h, 0px) + var(--safe-bottom) + var(--consent-lift, 0px) + 1rem);
    --companion-fab: 3.25rem;
    --cw: min(360px, calc(100vw - 24px));
    --ch: min(480px, calc(100dvh - 100px));
    position: fixed;
    right: max(0.85rem, env(safe-area-inset-right, 0px));
    bottom: var(--companion-bottom);
    /* Above legacy chat shell (70) so the FAB is never blocked when chat is closed. */
    z-index: var(--z-companion, 72);
    display: grid;
    justify-items: end;
    align-content: end;
    gap: 0.65rem;
    pointer-events: none;
    font-family: var(--font-body);
  }

  .companion > * {
    pointer-events: auto;
  }

  .companion[data-size='sm'] {
    --cw: min(320px, calc(100vw - 24px));
    --ch: min(400px, calc(100dvh - 100px));
  }

  .companion[data-size='md'] {
    --cw: min(360px, calc(100vw - 24px));
    --ch: min(480px, calc(100dvh - 100px));
  }

  .companion[data-size='lg'] {
    --cw: min(440px, calc(100vw - 24px));
    --ch: min(620px, calc(100dvh - 100px));
  }

  .companion-fab {
    --cc-access: #3b499f;
    --cc-access-ink: #2a3478;
    position: relative;
    display: grid;
    place-items: center;
    width: var(--companion-fab);
    height: var(--companion-fab);
    min-width: 50px;
    min-height: 50px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--cc-access);
    color: #fff;
    box-shadow: 0 12px 22px -10px rgb(27 32 80 / 0.55);
    cursor: pointer;
    transform: translateZ(0);
    transition:
      transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .companion-fab-tip {
    position: absolute;
    right: calc(100% + 0.55rem);
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    max-width: 11rem;
    padding: 0.35rem 0.55rem;
    border-radius: 0.45rem;
    border: 1px solid rgb(59 73 159 / 0.35);
    background: var(--cc-access-ink);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.25;
    white-space: nowrap;
    box-shadow: 0 8px 18px -12px rgb(36 40 43 / 0.55);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      visibility 0.18s ease;
  }

  .companion-fab-tip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    translate: 0 -50%;
    border: 5px solid transparent;
    border-left-color: var(--cc-access-ink);
  }

  .companion-fab:focus-visible .companion-fab-tip {
    opacity: 1;
    visibility: visible;
  }

  .companion-fab-mark {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .companion-fab:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 16px 26px -10px rgb(27 32 80 / 0.62);
    }

    .companion-fab:hover .companion-fab-tip {
      opacity: 1;
      visibility: visible;
    }
  }

  .companion-fab:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .companion-fab[aria-expanded='true'] {
    box-shadow:
      0 0 0 3px rgb(59 73 159 / 0.28),
      0 12px 22px -10px rgb(27 32 80 / 0.55);
  }

  /* Compact support panel above launcher — never fullscreen */
  .companion-panel {
    position: fixed;
    inset: auto;
    right: max(0.85rem, env(safe-area-inset-right, 0px));
    left: auto;
    bottom: calc(var(--companion-bottom) + var(--companion-fab) + 0.65rem);
    width: var(--cw);
    height: var(--ch);
    max-width: calc(100vw - 24px);
    max-height: calc(100dvh - 100px);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 1rem;
    background: transparent;
    color: var(--text);
    box-shadow: none;
    overflow: visible;
    translate: 0 0;
  }

  /* Phones: horizontally centered, stable first paint (no post-open jump) */
  @media (max-width: 39.99em) {
    .companion {
      --cw: min(380px, calc(100vw - 24px));
      --ch: min(500px, calc(100dvh - 100px));
      justify-items: center;
      right: 0;
      left: 0;
      width: 100%;
      padding-inline: 12px;
      box-sizing: border-box;
    }

    .companion-fab {
      justify-self: end;
    }

    .companion-panel {
      left: 50%;
      right: auto;
      translate: -50% 0;
      width: var(--cw);
      max-width: calc(100vw - 24px);
      max-height: calc(100dvh - 100px);
    }
  }

  .companion-panel::backdrop {
    background: rgb(36 40 43 / 0.28);
  }

  .companion-sheet {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    width: 100%;
    height: 100%;
    max-height: inherit;
    overflow: hidden;
    border: 1px solid rgb(28 32 36 / 0.1);
    border-radius: 1rem;
    background: linear-gradient(180deg, #fbf7f0 0%, #fff 38%);
    box-shadow: 0 22px 48px -22px rgb(28 32 36 / 0.45);
  }

  .companion-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 0.75rem 0.55rem;
    border-bottom: 1px solid rgb(28 32 36 / 0.06);
  }

  .companion-head-copy {
    min-width: 0;
  }

  .companion-head-copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--graphite);
  }

  .companion-sub {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  .companion-head-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.3rem;
    flex: none;
  }

  .companion-sizes {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.12rem;
    border: 1px solid rgb(28 32 36 / 0.1);
    border-radius: 0.55rem;
    background: var(--sand);
  }

  .companion-size-btn {
    min-height: 1.7rem;
    padding: 0 0.4rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .companion-size-btn.is-active,
  .companion-size-btn[aria-pressed='true'] {
    background: #fff;
    color: var(--graphite);
    box-shadow: var(--shadow-sm);
  }

  .companion-size-btn:focus-visible,
  .companion-icon-btn:focus-visible,
  .companion-tab:focus-visible,
  .companion-chat-chip:focus-visible,
  .companion-chat-send:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .companion-icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: rgb(28 32 36 / 0.06);
    color: var(--graphite);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .companion-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.2rem;
    padding: 0.45rem 0.55rem 0.35rem;
    border-bottom: 1px solid rgb(28 32 36 / 0.06);
    background: color-mix(in srgb, var(--sand) 55%, #fff);
  }

  .companion-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    min-height: 2.15rem;
    padding: 0.35rem 0.25rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .companion-tab.is-active,
  .companion-tab[aria-selected='true'] {
    background: #fff;
    color: var(--brand-ink);
    box-shadow: var(--shadow-sm);
  }

  .companion-tab-a11y-mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .companion-tab-a11y-mark :global(.universal-access-icon) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .companion-body {
    min-height: 0;
    overflow: hidden;
    display: grid;
  }

  .companion-view {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.7rem 0.75rem 0.9rem;
  }

  .companion-view[data-companion-view='chat'] {
    display: grid;
    padding: 0;
    overflow: hidden;
  }

  .companion-view[data-companion-view='chat'].is-active {
    display: grid;
  }

  .companion-view[hidden] {
    display: none !important;
  }

  .companion-a11y-note {
    margin: 0.85rem 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .companion-a11y-note a {
    display: inline;
    font-weight: 750;
    color: var(--brand-ink);
  }

  .companion-contact-lead {
    margin: 0 0 0.75rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .companion-contact-actions {
    display: grid;
    gap: 0.45rem;
  }

  .companion-contact-btn {
    justify-content: center;
    min-height: 2.55rem;
    font-size: 0.86rem;
  }

  .companion-contact-meta {
    margin: 0.65rem 0 0;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .companion-contact-meta a {
    color: inherit;
    font-weight: 700;
  }

  /* Embedded chat */
  .companion-chat {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    height: 100%;
  }

  .companion-chat-body {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.7rem 0.75rem 0.35rem;
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .companion-chat-msg {
    max-width: 95%;
    padding: 0.65rem 0.75rem;
    border-radius: 0.85rem;
    font-size: 0.86rem;
    line-height: 1.45;
    background: #fff;
    border: 1px solid rgb(28 32 36 / 0.08);
  }

  .companion-chat-msg p {
    margin: 0.25rem 0 0;
  }

  .companion-chat-msg p:first-child {
    margin-top: 0;
  }

  .companion-chat-lead {
    font-weight: 750;
    color: var(--graphite);
  }

  .companion-chat-msg-user {
    justify-self: end;
    background: var(--brand-soft);
    border-color: color-mix(in srgb, var(--brand) 35%, var(--line));
    color: var(--brand-ink);
  }

  .companion-chat-title {
    display: block;
    font-weight: 800;
    color: var(--graphite);
    margin-bottom: 0.2rem;
  }

  .companion-chat-points {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }

  .companion-chat-disclaimer {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .companion-chat-actions {
    display: block;
    margin-top: 0.5rem;
  }

  .companion-chat-actions a {
    font-weight: 750;
    color: var(--brand-ink);
  }

  .companion-chat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .companion-chat-chips[hidden] {
    display: none !important;
  }

  .companion-chat-chip {
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(28 32 36 / 0.1);
    border-radius: 999px;
    background: var(--sand);
    color: var(--graphite);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }

  .companion-chat-composer {
    padding: 0.55rem 0.65rem calc(0.55rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgb(28 32 36 / 0.08);
    background: #fff;
  }

  .companion-chat-input-wrap {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem;
    align-items: end;
    padding: 0.35rem;
    border: 1px solid rgb(28 32 36 / 0.12);
    border-radius: 0.85rem;
    background: var(--sand);
  }

  .companion-chat-input-wrap textarea {
    width: 100%;
    min-height: 2.4rem;
    max-height: 6rem;
    resize: none;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.35;
    padding: 0.45rem 0.4rem;
  }

  .companion-chat-input-wrap textarea:focus {
    outline: none;
  }

  .companion-chat-input-wrap:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
  }

  .companion-chat-send {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 0.65rem;
    background: var(--graphite);
    color: var(--ivory);
    cursor: pointer;
  }

  .companion-chat-hint {
    margin: 0.35rem 0 0;
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .companion-chat-thinking {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 650;
    color: var(--text-muted);
  }

  .companion-chat-dots {
    display: inline-flex;
    gap: 0.18rem;
  }

  .companion-chat-dots span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: currentColor;
    animation: companion-dot 1s ease-in-out infinite;
  }

  .companion-chat-dots span:nth-child(2) {
