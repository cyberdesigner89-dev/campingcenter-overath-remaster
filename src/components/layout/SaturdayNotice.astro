---
import Icon from '@/components/ui/Icon.astro';
---

<dialog
  class="sn"
  data-saturday-notice
  role="dialog"
  aria-modal="true"
  aria-labelledby="saturday-notice-title"
  aria-describedby="saturday-notice-body"
>
  <div class="sn-card">
    <button type="button" class="sn-close" data-saturday-dismiss aria-label="Hinweis schließen">
      <Icon name="close" />
    </button>
    <div class="sn-glow" aria-hidden="true"></div>
    <div class="sn-icon" aria-hidden="true">
      <Icon name="flame" />
    </div>
    <h2 id="saturday-notice-title">Liebe Campingfreunde,</h2>
    <div id="saturday-notice-body" class="sn-body">
      <p>ab sofort bleibt unser Campingcenter samstags geschlossen.</p>
      <p>Von Montag bis Freitag sind wir wie gewohnt gerne für euch da.</p>
      <p>Vielen Dank für euer Verständnis, wir freuen uns auf euren Besuch!</p>
    </div>
    <button type="button" class="btn sn-ok" data-saturday-dismiss>Verstanden</button>
  </div>
</dialog>

<style>
  .sn {
    width: min(26.5rem, calc(100vw - 1.5rem));
    max-height: min(92dvh, 40rem);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    color: var(--graphite);
  }

  .sn::backdrop {
    background:
      radial-gradient(80% 50% at 50% 40%, rgb(200 135 77 / 0.28), transparent 70%),
      rgb(20 16 12 / 0.62);
  }

  .sn-card {
    position: relative;
    overflow: auto;
    max-height: min(92dvh, 40rem);
    padding: 1.35rem 1.25rem 1.25rem;
    border-radius: 22px;
    border: 1px solid rgb(255 248 238 / 0.72);
    background-color: #f7f1e8;
    background-image: linear-gradient(180deg, rgb(255 250 244 / 0.98), rgb(247 241 232 / 0.98));
    box-shadow:
      0 30px 70px -28px rgb(36 24 12 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.75);
  }

  .sn[open] .sn-card {
    animation: sn-in 460ms var(--ease-out) both;
  }

  .sn-glow {
    position: absolute;
    inset: 0 0 auto;
    height: 7.5rem;
    background:
      radial-gradient(70% 90% at 18% 0%, rgb(232 150 72 / 0.34), transparent 70%),
      radial-gradient(50% 80% at 90% 10%, rgb(120 92 58 / 0.16), transparent 72%);
    pointer-events: none;
  }

  .sn-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.85rem;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-ink);
  }

  .sn-icon :global(.icon) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .sn-close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(250 248 244 / 0.96);
    color: var(--graphite);
    cursor: pointer;
  }

  .sn-close:hover {
    background: #fff;
  }

  .sn-close :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  h2 {
    position: relative;
    max-width: 16ch;
    margin: 0;
    padding-right: 2.5rem;
    font-family: var(--font-head);
    font-size: clamp(1.55rem, 1.3rem + 1vw, 2rem);
    font-weight: 650;
    line-height: 1.15;
    color: var(--graphite);
  }

  .sn-body {
    position: relative;
    display: grid;
    gap: 0.7rem;
    margin: 0.9rem 0 1.2rem;
  }

  .sn-body p {
    margin: 0;
    color: var(--graphite);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .sn-ok {
    position: relative;
    width: 100%;
  }

  @keyframes sn-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sn[open] .sn-card {
      animation: none;
    }
  }
</style>
