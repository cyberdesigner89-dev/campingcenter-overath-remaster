---
import Icon from '@/components/ui/Icon.astro';
import { company, openingHours, formatHours } from '@/data/company';
import { url } from '@/lib/url';
---
<div class="oh" data-opening-status data-state="pending" data-reason="hours">
  <div class="oh-alert" data-oh-alert hidden role="status">
    <span class="oh-alert-kicker">Heute Feiertag</span>
    <strong class="oh-alert-name" data-oh-alert-name></strong>
    <span class="oh-alert-closed">— wir haben geschlossen</span>
  </div>
  <div class="header-shell">
    <slot name="leading" />
    <div class="header-gap">
      <button type="button" class="oh-pill" data-oh-open aria-expanded="false" aria-controls="oh-sheet" data-state="pending" data-reason="hours" aria-label="Öffnungszeiten">
        <span class="oh-dot" aria-hidden="true"></span>
        <span class="oh-copy" aria-hidden="true">
          <span class="oh-lines">
            <span class="oh-line oh-line--full" data-oh-line-full>Öffnungszeiten</span>
            <span class="oh-line oh-line--short" data-oh-line-short>Öffnungszeiten</span>
            <span class="oh-line oh-line--compact" data-oh-line-compact>Öffnungszeiten</span>
          </span>
          <span class="oh-sub" data-oh-sub hidden></span>
        </span>
      </button>
    </div>
    <slot name="trailing" />
  </div>
  <dialog class="oh-sheet" id="oh-sheet" data-oh-sheet aria-labelledby="oh-sheet-title" aria-describedby="oh-saturday-title">
    <div class="oh-sheet-inner">
      <header class="oh-sheet-head"><p class="eyebrow" id="oh-sheet-title">Öffnungszeiten</p><button type="button" class="oh-close" data-oh-close aria-label="Schließen"><Icon name="close" /></button></header>
      <div class="oh-saturday-banner" role="note">
        <p class="oh-saturday-kicker">Wichtiger Hinweis</p>
        <p class="oh-saturday-title" id="oh-saturday-title">Samstags dauerhaft geschlossen</p>
        <p class="oh-saturday-text">Ab sofort bleibt das Campingcenter jeden Samstag geschlossen. Montag bis Freitag sind wir wie gewohnt für euch da.</p>
      </div>
      <div class="oh-banner" data-oh-banner data-state="pending" data-reason="hours">
        <p class="oh-banner-title" data-oh-banner-title>Öffnungszeiten</p>
        <p class="oh-banner-detail" data-oh-today></p>
        <p class="oh-banner-next" data-oh-next hidden></p>
      </div>
      <ul class="oh-week">
        {openingHours.map((p) => (
          <li class:list={[{ 'is-saturday': p.schemaDays.includes('Saturday') }]}>
            <strong>{p.days}</strong>
            <span>{p.schemaDays.includes('Saturday') ? 'dauerhaft geschlossen' : formatHours(p)}</span>
          </li>
        ))}
        <li><strong>Sonntag & Feiertage</strong><span>geschlossen</span></li>
      </ul>
      <p class="oh-sun">Samstags dauerhaft geschlossen, ebenso sonntags und an gesetzlichen Feiertagen (NRW).</p>
      <div class="btn-row">
        <a class="btn btn-accent btn-sm" href={company.phone.href}>Jetzt anrufen</a>
        <a class="btn btn-ghost btn-sm" href={company.directions} target="_blank" rel="noopener">Route <span class="sr-only">(öffnet in neuem Tab)</span></a>
        <a class="btn btn-ghost btn-sm" href={url('/kontakt/')}>Kontakt</a>
      </div>
    </div>
  </dialog>
</div>
<style>
  .oh {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /*
   * Mobile: logo | trailing on row 1; status on its own utility row (full width).
   * Desktop (≥90em): logo | intrinsic pill | nav — pill must not shrink below content.
   */
  .header-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'leading trailing'
      'gap gap';
    grid-template-rows: var(--header-h) var(--header-utility-h);
    align-items: center;
    column-gap: 0.75rem;
    width: min(100% - 2 * var(--gutter), 90rem);
    margin-inline: auto;
  }

  .header-gap {
    grid-area: gap;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 90em) {
    .header-shell {
      /* Intrinsic pill column — root fix for squeezed 1fr gap clipping dynamic strings */
      grid-template-columns: auto max-content minmax(0, 1fr);
      grid-template-areas: 'leading gap trailing';
      grid-template-rows: var(--header-h);
      column-gap: 0.65rem;
    }

    .header-gap {
      width: auto;
      max-width: none;
      justify-content: center;
      padding-inline: 0.25rem;
    }
  }

  .oh-alert {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.55rem;
    min-height: var(--header-alert-h-active);
    box-sizing: border-box;
    padding: 0.35rem 0.85rem;
    background: #c2410c;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 750;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .oh-alert[hidden] {
    display: none !important;
  }

  .oh-alert-kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 800;
    opacity: 0.95;
  }

  .oh-alert-name {
    font-size: 1rem;
    font-weight: 800;
  }

  .oh-alert-closed {
    font-weight: 700;
  }

  .oh-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    max-width: 100%;
    min-height: 2.75rem;
    box-sizing: border-box;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.92);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
    text-align: left;
  }

  @media (min-width: 90em) {
    .oh-pill {
      align-items: flex-start;
      min-height: 0;
      padding: 0.4rem 0.75rem;
      /* Never shrink below label — header gives max-content track instead */
      flex: 0 0 auto;
    }
  }

  .oh-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.35rem;
    min-width: 0;
  }

  .oh-lines {
    display: contents;
  }

  .oh-line {
    white-space: nowrap;
    line-height: 1.25;
  }

  /* Only the active length contributes to intrinsic width (no stacked invisible text). */
  .oh-line--full,
  .oh-line--short {
    display: none;
  }

  .oh-line--compact {
    display: inline;
  }

  @media (min-width: 22.5em) {
    .oh-line--compact {
      display: none;
    }

    .oh-line--short {
      display: inline;
    }
  }

  @media (min-width: 90em) {
    .oh-line--short {
      display: none;
    }

    .oh-line--full {
      display: inline;
    }

    .oh-copy {
      display: grid;
      gap: 0.05rem;
    }

    .oh-sub:not([hidden])::before {
      content: none;
    }
  }

  .oh-sub {
    font-size: 0.75rem;
    font-weight: 650;
    opacity: 0.85;
    line-height: 1.25;
    white-space: nowrap;
  }

  .oh-sub:not([hidden])::before {
    content: '· ';
  }

  .oh-sub[hidden] {
    display: none;
  }

  @media (max-width: 22.49em) {
    .oh-sub:not([hidden]) {
      display: none;
    }
  }

  .oh-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--text-muted);
    flex: none;
  }

  @media (min-width: 90em) {
    .oh-dot {
      margin-top: 0.22rem;
    }
  }

  .oh-pill[data-state='open'] .oh-dot {
    background: var(--success);
    box-shadow: 0 0 0 3px rgb(from var(--success) r g b / 0.22);
  }

  .oh-pill[data-state='closed'] {
    border-color: #b91c1c;
    background: #fef2f2;
    color: #7f1d1d;
  }

  .oh-pill[data-state='closed'] .oh-dot {
    background: #dc2626;
  }

  .oh-pill[data-reason='holiday'] {
    border-color: #9a3412;
    background: #ffedd5;
    color: #7c2d12;
  }

  .oh-pill[data-reason='holiday'] .oh-dot {
    background: #ea580c;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill {
    border-color: rgb(255 255 255 / 0.35);
    background: rgb(14 12 10 / 0.45);
    color: #fff;
  }

  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-state='closed'],
  .site-header[data-overlay]:not(.is-solid) .oh-pill[data-reason='holiday'] {
    border-color: #fdba74;
    background: rgb(154 52 18 / 0.85);
    color: #fff;
  }

  .oh-sheet {
    width: min(100% - 1.5rem, 24rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .oh-sheet::backdrop {
    background: rgb(14 12 10 / 0.45);
  }

  .oh-sheet-inner {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .oh-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .oh-saturday-banner {
    margin: 0.9rem 0 0.15rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    background: #9a3412;
    color: #fff;
  }

  .oh-saturday-kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .oh-saturday-title {
    margin: 0.2rem 0 0;
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .oh-saturday-text {
    margin: 0.4rem 0 0;
    font-size: var(--fs-sm);
    font-weight: 650;
    line-height: 1.45;
  }

  .oh-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--sand);
    cursor: pointer;
  }

  .oh-banner {
    margin: 0.85rem 0 1.15rem;
    padding: 0.95rem 1rem;
    border-radius: var(--radius);
    background: var(--sand);
  }

  .oh-banner[data-state='open'] {
    background: var(--success-soft);
  }

  .oh-banner[data-state='closed'] {
    background: #fef2f2;
    color: #7f1d1d;
  }

  .oh-banner[data-reason='holiday'] {
    background: #ffedd5;
    color: #7c2d12;
  }

  .oh-banner-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .oh-banner-detail,
  .oh-banner-next {
    margin: 0.4rem 0 0;
    font-size: var(--fs-sm);
    font-weight: 650;
  }

  .oh-banner-next[hidden] {
    display: none;
  }

  .oh-week {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oh-week li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--fs-sm);
  }

  .oh-week li.is-saturday {
    margin-inline: -0.35rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    background: #fff7ed;
    color: #9a3412;
    font-weight: 750;
  }

  .oh-week li.is-saturday span {
    font-weight: 800;
  }

  .oh-sun {
    margin: 0.85rem 0 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 650;
  }
</style>

<!-- Opening status + sheet: live paint via boot __ccoRefreshOpen; sheet bound in site.ts -->
